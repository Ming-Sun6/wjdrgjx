<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <rewrite>
      <rules>
        <rule name="RedirectLegacyGgPromoToWjdrHome" stopProcessing="true">
          <match url="^public/gg/promo-detail(\.html)?$" />
          <action type="Redirect" url="/public/wjdr-home/board" redirectType="Permanent" appendQueryString="false" />
        </rule>

        <rule name="RedirectEngineeringStationTimeLegacyPublic" stopProcessing="true">
          <match url="^public/function/Engineering%20Station%20Time\.html$" />
          <action type="Redirect" url="/public/function/engineering-station-time.html" redirectType="Permanent" />
        </rule>

        <rule name="RedirectEngineeringStationTimeLegacy" stopProcessing="true">
          <match url="^function/Engineering%20Station%20Time\.html$" />
          <action type="Redirect" url="/public/function/engineering-station-time.html" redirectType="Permanent" />
        </rule>

        <!-- 论坛详情必须经过 Node，才能按帖子 ID 输出标题、摘要和帖子图片。 -->
        <rule name="ReverseProxyForumPostToNode3000" stopProcessing="true">
          <match url="^(?:public/)?function/forum-post(?:\.html)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/function/forum-post.html" appendQueryString="true" />
        </rule>

        <!-- 工具 HTML 统一经过 Node，让后台“工具启用”开关可以阻止直链。 -->
        <rule name="ReverseProxyFunctionHtmlToNode3000" stopProcessing="true">
          <match url="^(?:public/)?function/(.+\.html)$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/function/{R:1}" appendQueryString="true" />
        </rule>

        <rule name="ReverseProxyFunctionDirectoryIndexToNode3000" stopProcessing="true">
          <match url="^(?:public/)?function/(.+)/$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}public\function\{R:1}\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/function/{R:1}/" appendQueryString="true" />
        </rule>

        <rule name="ReverseProxyFunctionExtensionlessToNode3000" stopProcessing="true">
          <match url="^function/(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{APPL_PHYSICAL_PATH}public\function\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:3000/function/{R:1}" appendQueryString="true" />
        </rule>

        <!-- 支持无扩展名 function 页面：/function/page → /public/function/page.html（仅当 .html 存在） -->
        <rule name="RewriteFunctionExtensionlessToPublicHtml" stopProcessing="true">
          <match url="^function/(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}public\function\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/public/function/{R:1}.html" />
        </rule>

        <rule name="StaticFunctionToPublicFunction" stopProcessing="true">
          <match url="^function/(.*)" />
          <action type="Rewrite" url="/public/function/{R:1}" />
        </rule>

        <!-- 地图编辑器入口走 Node，才能套用工具启用 / 指定用户。 -->
        <rule name="ReverseProxyMapToolIndexToNode3000" stopProcessing="true">
          <match url="^(?:public/)?map-tool(/|/index\.html)?$" />
          <action type="Rewrite" url="http://127.0.0.1:3000/map-tool/" appendQueryString="true" />
        </rule>

        <!-- 静态资源必须指向 public/map-tool，避免 IIS 命中仓库里的 Vue 源码目录。 -->
        <rule name="StaticMapToolToPublicMapTool" stopProcessing="true">
          <match url="^map-tool/(.+)$" />
          <action type="Rewrite" url="/public/map-tool/{R:1}" />
        </rule>

        <!-- 让浏览器地址栏不显示 .html：访问 *.html → 301 到无扩展名（排除百度站长文件验证 *.html，须直接 200） -->
        <rule name="RedirectHtmlToExtensionless" stopProcessing="true">
          <match url="^(.*)\.html$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/baidu_verify_.+\.html(\?|$)" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/(?:public/)?map-tool/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="Redirect" url="/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>

        <!-- 支持无扩展名：/path/to/page → 内部重写到 /path/to/page.html（仅当对应 .html 存在） -->
        <rule name="RewriteExtensionlessToHtml" stopProcessing="true">
          <match url="^(.+)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{REQUEST_FILENAME}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
        <rule name="RedirectDuihuanToGiftcode" stopProcessing="true">
          <match url="^function/duihuan(\.html)?$" />
          <action type="Redirect" url="/giftcode/" redirectType="Permanent" />
        </rule>

        <rule name="ReverseProxyGiftcodeUiToNode3000" stopProcessing="true">
          <match url="^(?:public/)?giftcode(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/giftcode{R:1}" />
        </rule>

        <rule name="ReverseProxyAeroplaneChessWsToNode3000" stopProcessing="true">
          <match url="^ws(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:0}" />
        </rule>

        <rule name="ReverseProxyApiToNode3001" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
        <defaultDocument>
            <files>
                <remove value="rukou.html" />
                <remove value="index.html" />
                <remove value="index.htm" />
                <remove value="iisstart.htm" />
                <remove value="Default.htm" />
                <add value="index.html" />
            </files>
        </defaultDocument>
  </system.webServer>
</configuration>
