# ========== Toolbox (Node) - Aliyun RDS PostgreSQL ==========
PGHOST=postgres.example.com
PGPORT=5432
PGUSER=db_user
PGPASSWORD=replace_with_database_password
PGDATABASE=postgres
PGSSLMODE=require

# Giftcode / wjdr-giftcode 需要 Python 3（若 PATH 无 python 或仅有 Windows 商店占位，请取消下行注释）
# PYTHON_CMD=C:\Python314\python.exe

# ========== Giftcode (Flask) - uses same PG* vars above ==========
SECRET_KEY=change-me-to-a-random-string
VERIFY_FID=000000000
GIFTCODE_SERVICE_URL=http://127.0.0.1:5201
GIFTCODE_URL_PREFIX=/giftcode
GIFTCODE_PORT=5201
# placeholder = static "under development" page (no Python needed)
# live = full Flask giftcode UI (requires wjdr-giftcode on 5201)
GIFTCODE_UI_MODE=live

# Optional: Redis for recent redeem list / rate limit (Aliyun Redis or local)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Local dev only (omit on server):
# MYSQL_URL=mysql+pymysql://user:pass@127.0.0.1:3306/dbname?charset=utf8mb4
