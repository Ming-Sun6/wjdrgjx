PGHOST=postgres.example.com
PGPORT=5432
PGUSER=db_user
PGPASSWORD=replace_with_database_password
PGDATABASE=postgres

# Set to require if your RDS instance requires SSL.
PGSSLMODE=

# wjdr-giftcode (Flask) integration
GIFTCODE_SERVICE_URL=http://127.0.0.1:5201
GIFTCODE_URL_PREFIX=/giftcode
GIFTCODE_PORT=5201
