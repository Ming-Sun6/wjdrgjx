# redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# mysql
MYSQL_URL=mysql+pymysql://user:password@127.0.0.1:3306/dbname?charset=utf8mb4

# API sign key (must match webpack bundle)
SECRET_KEY=change-me-to-a-random-string

# verify new codes by redeeming with this game account fid
VERIFY_FID=000000000

# toolbox integration (empty when running standalone)
GIFTCODE_URL_PREFIX=/giftcode
GIFTCODE_PORT=5201
