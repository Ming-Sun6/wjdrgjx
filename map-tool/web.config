<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- 防止 IIS 把本目录当成站点内容：这里是 Vite 源码，真正的线上产物在 /public/map-tool。 -->
    <rewrite>
      <rules>
        <rule name="MapToolSourceDirIndex" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="/public/map-tool/index.html" />
        </rule>
        <rule name="MapToolSourceDirFiles" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="/public/map-tool/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
